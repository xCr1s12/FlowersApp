{
  "expo": {
    "name": "FlowersApp",
    "slug": "FlowersApp",
    "version": "1.0.0",
    "scheme": "flowersapp",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8E7C4",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.FlowersApp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#F8E7C4",
          "android": {
            "image": "./src/assets/splash-icon.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#F8E7C4"
          }
        }
      ]
    ]
  }
}
